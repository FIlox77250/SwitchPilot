<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SwitchPilot.App.Views.InventoryWindow" Title="Inventaire des prises" Width="850" Height="590" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Inventaire des prises" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Associer le port actuellement détecté à un nom de prise murale." Margin="0,12,0,12"/><TextBlock Text="{Binding ResultSwitch}"/><TextBlock Text="{Binding ResultPort}"/></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,16,0,16"><Button DockPanel.Dock="Right" Content="Associer à ce port" Command="{Binding SaveOutletCommand}"/><TextBox Text="{Binding OutletName, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Tag="Salle 104 - P12" Margin="0,0,12,0"/></DockPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Outlets}"><DataGrid.Columns><DataGridTextColumn Header="Switch" Binding="{Binding Switch}" Width="200"/><DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="120"/><DataGridTextColumn Header="Prise" Binding="{Binding Outlet}" Width="*"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock Text="{Binding InventoryStatus}" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Importer CSV" Command="{Binding ImportOutletsCommand}"/><Button Content="Exporter CSV" Command="{Binding ExportOutletsCommand}"/><Button Content="Fermer" Click="CloseWindow"/></StackPanel></StackPanel>
  </Grid>
</Window>
