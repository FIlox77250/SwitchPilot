<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SwitchPilot.App.Views.UpdateWindow" Style="{StaticResource {x:Type Window}}" Title="Mise à jour de Switch Pilot" Width="640" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30">
      <TextBlock Text="Mise à jour" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding Message}" Margin="0,0,0,10"/>
      <TextBlock Text="{Binding VersionLabel}" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <TextBlock Text="Nouveautés" Style="{StaticResource Label}"/>
      <Border Style="{StaticResource Card}" Padding="16" MaxHeight="300">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>
      <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Height="4" Margin="0,0,0,16"/>
      <WrapPanel>
        <Button Content="Installer maintenant" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}"/>
        <Button Content="Télécharger depuis GitHub" Command="{Binding OpenPageCommand}"/>
        <Button Content="Plus tard" Click="LaterClick"/>
      </WrapPanel>
      <Button Content="Ne plus proposer cette version" Command="{Binding SkipCommand}" Click="SkipClick" HorizontalAlignment="Left" Margin="0,14,0,0"/>
      <TextBlock Text="L'application télécharge l'exécutable depuis GitHub, vérifie son empreinte SHA-256, puis redémarre pour l'installer. Vos paramètres et sauvegardes restent inchangés." Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
