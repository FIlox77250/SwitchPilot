<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SwitchPilot.App.Views.ConnectionWindow" Style="{StaticResource {x:Type Window}}" Title="Connexion au switch" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="32">
    <TextBlock Text="Connecter un switch" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="Cisco IOS · SSH" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
    <TextBlock Text="Profils enregistrés" Style="{StaticResource Label}"/>
    <ComboBox x:Name="Profiles" DisplayMemberPath="Host" SelectionChanged="ProfileChanged"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="90"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0">
        <TextBlock Text="Adresse IP ou nom DNS" Style="{StaticResource Label}"/>
        <TextBox x:Name="Host" MaxLength="253" AutomationProperties.Name="Adresse du switch"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Port" Style="{StaticResource Label}"/>
        <TextBox x:Name="Port" Text="22" MaxLength="5" AutomationProperties.Name="Port SSH"/>
      </StackPanel>
    </Grid>
    <TextBlock Text="Utilisateur" Style="{StaticResource Label}"/>
    <TextBox x:Name="Username" MaxLength="128"/>
    <TextBlock Text="Mot de passe SSH" Style="{StaticResource Label}"/>
    <PasswordBox x:Name="Password"/>
    <TextBlock Text="Mot de passe enable (si nécessaire)" Style="{StaticResource Label}"/>
    <PasswordBox x:Name="EnablePassword"/>
    <CheckBox x:Name="Remember" Content="Mémoriser les identifiants, chiffrés pour ce compte Windows" Margin="0,4,0,14"/>
    <CheckBox x:Name="Legacy" Content="Compatibilité SSH ancien IOS (algorithmes hérités)" Margin="0,0,0,8"/>
    <TextBlock Text="Activez cette option seulement si votre ancien IOS refuse la négociation SSH moderne. La clé du switch reste vérifiée." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
    <TextBlock x:Name="Error" Foreground="#A04D3F" Margin="0,0,0,10"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Annuler" IsCancel="True"/>
      <Button Content="Se connecter" Click="Connect" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
  </StackPanel>
</Window>
